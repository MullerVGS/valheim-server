# copiar p/ .env no host (chmod 600). .env nunca vai pro git.

SERVER_NAME=nome-do-servidor
WORLD_NAME=nome-do-mundo
SERVER_PASS=trocar-min-5-chars
# 1 = anunciado na lista publica; 0 = so entra por IP/codigo
SERVER_PUBLIC=0
SERVER_PORT=2456

# SteamID64 separados por espaco. identificador dos amigos: fora do git.
ADMINLIST_IDS=
PERMITTEDLIST_IDS=

# teto de RAM do container
MEM_LIMIT=4g

TZ=America/Sao_Paulo
