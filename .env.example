# cp .env.example .env && chmod 600 .env — never commit .env

SERVER_NAME=my-server
WORLD_NAME=my-world
# >=5 chars, not contained in SERVER_NAME
SERVER_PASS=change-me
# 1 = listed in the server browser; 0 = join by IP
SERVER_PUBLIC=0
# query port is always SERVER_PORT+1
SERVER_PORT=2456
SERVER_QUERY_PORT=2457

# SteamID64, space separated. Empty whitelist = anyone with the password.
ADMINLIST_IDS=
PERMITTEDLIST_IDS=

MEM_LIMIT=4g
TZ=UTC

# backup before update; restart only runs with nobody online
BACKUPS_CRON=0 7 * * *
UPDATE_CRON=0 8 * * *
RESTART_CRON=10 5 * * *

# world modifiers, e.g. -resetmodifiers -modifier deathpenalty casual -setkey playerevents
SERVER_ARGS=

# --- plugin (docs/plugin.md). Everything below needs BEPINEX=true; empty = vanilla ---
BEPINEX=false
VALHEIM_SERVER_FPS=
VALHEIM_ZDO_SEND_LIMIT_BYTES=
VALHEIM_STEAM_SEND_RATE_BYTES=
VALHEIM_DEFER_ASSET_UNLOAD=
VALHEIM_OWNER_HYSTERESIS=
VALHEIM_SIGN_ICONS_CATALOG=
VALHEIM_ACCESS_PORT=
VALHEIM_SLOT_MARKS=
VALHEIM_FIRE_FUEL_FACTOR=
VALHEIM_SUMMON_NAMES=
VALHEIM_CHUNK_LOADER=
VALHEIM_MAP_DIR=
VALHEIM_MAP_PIECES_MINUTES=
VALHEIM_MAP_SCAN_BUDGET_MS=

# --- site (site/README.md) ---
SITE_VM_URL=http://victoriametrics:8428
