# copiar p/ .env no host (chmod 600). .env nunca vai pro git.

SERVER_NAME=nome-do-servidor
WORLD_NAME=nome-do-mundo
SERVER_PASS=trocar-min-5-chars
# 1 = anunciado na lista publica; 0 = so entra por IP/codigo
SERVER_PUBLIC=0

# query port e sempre SERVER_PORT+1
SERVER_PORT=2456
SERVER_QUERY_PORT=2457

# SteamID64 separados por espaco. identificador dos amigos: fora do git.
ADMINLIST_IDS=
PERMITTEDLIST_IDS=

# teto de RAM do container
MEM_LIMIT=4g

# true = BepInEx + plugin de metricas (ver README)
BEPINEX=false

# icones nas placas: caminho do catalogo no container (ver README). vazio = desligado
VALHEIM_SIGN_ICONS_CATALOG=

# pagina de pedidos de entrada na whitelist: porta no container, sem login (ver README). vazio = desligada
VALHEIM_ACCESS_PORT=

# limpeza horaria de assets so com o servidor vazio: 1 = ligado. vazio = jogo
VALHEIM_DEFER_ASSET_UNLOAD=
# troca de dono com histerese: on | measure (so conta) | vazio = jogo
VALHEIM_OWNER_HYSTERESIS=

# slots de bau reservados por pilha de zero: 1 = ligado (ver README). vazio = desligado
VALHEIM_SLOT_MARKS=

# combustivel de fogo N vezes mais lento, 2..100 (ver README). vazio = jogo
VALHEIM_FIRE_FUEL_FACTOR=

# tiles do mapa das mesas de cartografia para o Grafana (ver README). vazio = sem tiles
VALHEIM_MAP_DIR=
# desenho diario dos tiles (ver README). vazio = padrao: 04:30, zoom 17, duty 0.5, varredura 1 ms/frame
VALHEIM_MAP_DRAW_AT=
VALHEIM_MAP_MAX_ZOOM=
VALHEIM_MAP_DRAW_DUTY=
VALHEIM_MAP_SCAN_BUDGET_MS=

# horario morto: os dois reiniciam ou pesam no servidor. backup antes do update.
BACKUPS_CRON=0 7 * * *
UPDATE_CRON=0 8 * * *
# restart diario, so com o servidor vazio (valheim-is-idle). default da imagem: 10 5 * * *
RESTART_CRON=10 5 * * *

TZ=America/Sao_Paulo

# argumentos extras do servidor. World Modifiers, ex.: -modifier deathpenalty casual
# valores validos vem dos sliders do jogo; valor fora deles vira chave "cheated"
# e desliga os achievements da plataforma. remover a linha nao reverte: -resetmodifiers.
SERVER_ARGS=
